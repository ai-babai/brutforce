{
  "openapi": "3.1.0",
  "info": {
    "title": "BrutForce internal search and recommendation contract",
    "version": "1.0.0",
    "description": "Contract for Roman and the deterministic reference implementation. Independently configured search/recommendation URLs; internal HTTP only, no browser access. One or multiple processes permitted. See wine-services.md for semantics and timeout budgets. Not the organizer contest API."
  },
  "servers": [
    {
      "url": "http://127.0.0.1:8101",
      "description": "Local reference default; not a deployed production endpoint"
    }
  ],
  "paths": {
    "/v1/search/text": {
      "post": {
        "operationId": "textSearch",
        "summary": "Rank wines by text",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-ID",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9-]+$"
            },
            "description": "Safe correlation ID; do not put personal data or credentials here."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/TextSearch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked matches from the requested catalog version.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or invalid image.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown source wine or route.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Unsupported catalog version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Input exceeds size bound.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Capacity exhausted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Engine unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Deadline exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/search/image": {
      "post": {
        "operationId": "imageSearch",
        "summary": "Rank wines by image",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-ID",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9-]+$"
            },
            "description": "Safe correlation ID; do not put personal data or credentials here."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/ImageSearch"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked matches from the requested catalog version.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or invalid image.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown source wine or route.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Unsupported catalog version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Input exceeds size bound.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Capacity exhausted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Engine unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Deadline exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/recommendations": {
      "post": {
        "operationId": "recommendations",
        "summary": "Recommend alternatives to a known wine",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-ID",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^[A-Za-z0-9-]+$"
            },
            "description": "Safe correlation ID; do not put personal data or credentials here."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/Recommendations"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Ranked matches from the requested catalog version.",
            "headers": {
              "X-Request-ID": {
                "schema": {
                  "type": "string"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RankedResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request or invalid image.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Unknown source wine or route.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "405": {
            "description": "Method not allowed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Unsupported catalog version.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "413": {
            "description": "Input exceeds size bound.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "429": {
            "description": "Capacity exhausted.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Engine unavailable.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "504": {
            "description": "Deadline exceeded.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/v1/health": {
      "get": {
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Process alive, not proof of model quality/readiness.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "TextSearch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "query",
          "catalogVersion"
        ],
        "properties": {
          "catalogVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          },
          "query": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "description": "Trimmed nonempty Unicode text, no control characters."
          }
        }
      },
      "ImageSearch": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "image",
          "catalogVersion"
        ],
        "properties": {
          "catalogVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          },
          "image": {
            "type": "string",
            "format": "binary",
            "description": "One JPEG/PNG/GIF, max10MiB, side<=12000px, pixels<=25000000. Validate actual decoding; never fetch URLs."
          }
        }
      },
      "Recommendations": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wineId",
          "catalogVersion"
        ],
        "properties": {
          "catalogVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10,
            "default": 5
          },
          "wineId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        }
      },
      "Candidate": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "score"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "score": {
            "type": "number",
            "minimum": 0,
            "maximum": 1,
            "description": "Ranking score, not calibrated probability. Non-increasing order; ties permitted."
          }
        }
      },
      "RankedResponse": {
        "type": "object",
        "additionalProperties": true,
        "required": [
          "catalogVersion",
          "modelVersion",
          "demo",
          "candidates"
        ],
        "properties": {
          "catalogVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "modelVersion": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "demo": {
            "type": "boolean"
          },
          "candidates": {
            "type": "array",
            "maxItems": 10,
            "items": {
              "$ref": "#/components/schemas/Candidate"
            }
          },
          "selectedId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "description": "Exact catalog IDs, unique, at most requested limit, preserved order. Search selectedId must be a candidate. Recommendations omit selectedId and exclude source wineId. Return [] for genuine absence, not dependency errors. demo=true for synthetic reference."
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "code",
              "message"
            ],
            "properties": {
              "code": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "message": {
                "type": "string",
                "minLength": 1,
                "maxLength": 512
              }
            }
          }
        }
      },
      "Health": {
        "type": "object",
        "required": [
          "ok"
        ],
        "properties": {
          "ok": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
