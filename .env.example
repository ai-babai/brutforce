# Internal AI services provisioned by the team. Keep the real token outside Git.
BIFROST_BASE_URL=http://bifrost.ai--bifrost/v1
BIFROST_TOKEN=
DOCLING_URL=http://docling.ai--docling

# These services augment but do not replace visual retrieval.
OCR_MODEL=kristaller486/dots.ocr-1.5
LLM_MODEL=sgl/openai/gpt-oss-120b
TEXT_EMBEDDING_MODEL=vllm/BAAI/bge-m3
TEXT_RERANKER_MODEL=vllm/BAAI/bge-reranker-v2-m3

# External Dataset root on sigma-ops. Override locally as needed.
VINO_DATASET_ROOT=/srv/lct/data/roman/vino/current/Dataset
