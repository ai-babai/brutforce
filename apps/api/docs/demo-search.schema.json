{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Demo search success response — not the contest API",
  "type": "object",
  "required": [
    "demo",
    "candidates"
  ],
  "properties": {
    "demo": {
      "const": true
    },
    "selectedId": {
      "type": "string",
      "description": "Выбор сервиса среди candidates; несколько результатов фото UI показывает списком для явного выбора пользователем (FE-035)."
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "winery",
          "year",
          "image",
          "description"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "winery": {
            "type": "string"
          },
          "year": {
            "type": "integer"
          },
          "image": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "catalogVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "modelVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    }
  }
}
