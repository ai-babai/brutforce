{
  "version": "2.0",
  "color": {
    "action": "#8f3d42",
    "actionHover": "#ab494f",
    "actionPressed": "#723135",
    "ink": "#2c2a28",
    "muted": "#746e68",
    "paper": "#fefdfa",
    "surface": "#fdf9ed",
    "homeSurface": "#fbf6ec",
    "border": "#d7d4d2",
    "glassWarm": "#efdbc64d",
    "glassMilk": "#ffffffe6"
  },
  "type": {
    "display": "Playfair Display",
    "interface": "system-ui, -apple-system, sans-serif",
    "bodyMinimum": 14,
    "touchLabelMinimum": 14
  },
  "radius": {
    "button": 16,
    "card": 24,
    "sheet": 32,
    "pill": 999
  },
  "space": [
    4,
    8,
    12,
    16,
    24,
    32,
    48
  ],
  "targetMinimum": 44,
  "materials": {
    "navigation": {
      "blur": 10,
      "fill": "#efdbc64d"
    },
    "search": {
      "blur": 5,
      "fill": "#ffffffe6"
    },
    "content": {
      "blur": 0,
      "fill": "#fdf9ed"
    },
    "home": {
      "blur": 0,
      "fill": "#fbf6ec",
      "rule": "Brand context and hero share one continuous surface"
    }
  },
  "mascot": {
    "asset": "assets/v2/mascot-hold-2d-alpha.png",
    "role": "Home editorial scene directing attention to the bottle label",
    "exclude": [
      "camera",
      "source photo",
      "wine result",
      "candidate comparison",
      "system gallery",
      "permission errors"
    ],
    "secondary": {
      "loading": "assets/v2/mascot-walk-2d-alpha.png",
      "waiting": "assets/v2/mascot-walk-2d-alpha.png",
      "missing": "assets/v2/mascot-counter-thoughtful-2d-alpha.png",
      "searchEmpty": "assets/v2/mascot-cellar-2d-alpha.png",
      "offline": "assets/v2/mascot-offline-2d-alpha.png"
    }
  },
  "status": "Prototype specification; not official brand standards or production code",
  "navigation": {
    "sections": [
      "home",
      "search",
      "saved"
    ],
    "hiddenOn": [
      "camera"
    ],
    "itemTargetMinimum": 48,
    "widePhoneFrame": true
  },
  "copy": {
    "homeTitle": "Какое вино перед вами?",
    "homeNavigationLabel": "Главная"
  }
}
