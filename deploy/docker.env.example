# Copy to deploy/.env.local (gitignored); absolute paths must exist on this host.
# Files containing credentials are under SECRETS_DIR and never pass to docker build.
ASSET_DIR=/path/to/verified-private/f8-bundle
CATALOG_PACKAGE_DIR=/path/to/approved-display-release
CATALOG_MEDIA_DIR=/path/to/approved-catalog-media
CATALOG_VERSION=svoe-20260927-alpha-2035-v1
RECOMMENDATION_INDEX_FILE=/path/to/approved-recommendation-index.json
RECOMMENDATION_INDEX_SHA256=f05f16c7790782ec3c1b50047bba4e29f1d906217f63846c217d5516e6ef8e7f
SECRETS_DIR=/path/to/private-compose-secrets
FEEDBACK_CAMPAIGN_ID=local-compose
