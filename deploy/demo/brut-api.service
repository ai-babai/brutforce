[Unit]
Description=BrutForce read-only demo (file catalog, no model or database)
After=network.target

[Service]
Type=simple
User=brut
Group=brut
EnvironmentFile=/etc/brut/runtime.env
WorkingDirectory=/srv/brut/current
ExecStart=/srv/brut/current/api/brut-api
Restart=on-failure
RestartSec=3
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
IPAddressDeny=any
IPAddressAllow=localhost
TemporaryFileSystem=/tmp:rw,size=16M,mode=1777
UMask=0077
MemoryMax=256M
CPUQuota=100%
TasksMax=64
LimitNOFILE=1024
LogRateLimitIntervalSec=30s
LogRateLimitBurst=100

[Install]
WantedBy=multi-user.target
