FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7 AS wheels
COPY deploy/assets/vision-requirements.txt /requirements.txt
RUN python -m pip install --no-cache-dir --prefix=/install -r /requirements.txt

FROM python:3.12.11-slim-bookworm@sha256:519591d6871b7bc437060736b9f7456b8731f1499a57e22e6c285135ae657bf7
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 tesseract-ocr && \
    rm -rf /var/lib/apt/lists/* && groupadd -g 10002 vision && \
    useradd -u 10002 -g 10002 -M -s /usr/sbin/nologin vision
COPY --from=wheels /install/ /usr/local/
COPY scripts/docker-vision-bridge.py /usr/local/bin/docker-vision-bridge.py
COPY apps/vision/ /app/vision/
ENV HF_HOME=/assets/models HF_HUB_OFFLINE=1 HF_HUB_DISABLE_TELEMETRY=1 \
    TRANSFORMERS_OFFLINE=1 TOKENIZERS_PARALLELISM=false PYTHONDONTWRITEBYTECODE=1 \
    OMP_NUM_THREADS=6 MKL_NUM_THREADS=6 MALLOC_ARENA_MAX=2 PYTHONUNBUFFERED=1 \
    NIGHT_SO_ONNX_DIR=/assets/onnx NIGHT_SO_ONNX_THREADS=6 \
    F0_BASE_CODE_DIR=/app/vision/parent F8_OCR_LEXICON_SPEC=/app/vision/overlay/spec/lexicon.json \
    TESSDATA_PREFIX=/assets/ocr
COPY scripts/docker-vision-health.py /usr/local/bin/docker-vision-health.py
USER 10002:10002
EXPOSE 8127
CMD ["python", "/usr/local/bin/docker-vision-bridge.py"]
